# MongoDB is the durable source of truth for user-owned application data.
MONGODB_URL=mongodb+srv://replace-me
DATABASE_NAME=personal_agent

# Backend-to-agent service connection. Use the same random secret in agent/.env.
AGENT_SERVICE_URL=https://your-private-agent-service.example
AGENT_SERVICE_TOKEN=replace-with-a-long-random-secret
AGENT_TIMEOUT_SECONDS=45

# Google Sign-In Web OAuth client. The client ID is also used by the frontend.
GOOGLE_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
ALLOWED_GOOGLE_EMAIL=owner@example.com

# Generate a high-entropy random signing key. Never reuse the service token.
SESSION_JWT_SECRET=replace-with-a-separate-long-random-secret
SESSION_TTL_SECONDS=3600
FRONTEND_ORIGINS=http://localhost:5173
MAX_REQUEST_BODY_BYTES=31457280
