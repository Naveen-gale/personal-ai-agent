# Copy to agent/.env and fill in locally. Never commit agent/.env.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Required when the agent API is deployed privately behind the central backend.
AGENT_SERVICE_TOKEN=replace-with-the-same-random-secret-as-backend

# MongoDB-backed workflow storage. Import existing agent/workflows.db before
# starting with WORKFLOW_STORAGE=mongodb.
WORKFLOW_STORAGE=mongodb
WORKFLOW_MONGODB_URL=mongodb+srv://workflow-user:replace-me
DATABASE_NAME=personal_agent

# Optional timezone and persistent reminder database location.
USER_TIMEZONE=Asia/Kolkata
REMINDERS_DB_PATH=agent/reminders.db

# Reminder delivery configuration (only required for Telegram reminders).
# There is no inbound Telegram bot in this project.
TELEGRAM_BOT_TOKEN=replace-with-your-reminder-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id

# Existing Google OAuth uses agent/credentials.json and agent/token.json.
# Optional overrides support secret-file mounts and persistent token storage.
# GOOGLE_CREDENTIALS_FILE=/etc/secrets/credentials.json
# GOOGLE_TOKEN_FILE=/var/data/token.json
# Reauthorize through: python -m agent.auth.gmail_auth

# Drive/Photos uploads are limited to 25 MiB per file by default.
DRIVE_MAX_UPLOAD_BYTES=26214400
